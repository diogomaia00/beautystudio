meta {
  name: BO mark appointment made
  type: http
  seq: 5
}

post {
  url: {{base_url}}/bo/v1/appointments/{{appointment_id}}/made/
  body: none
  auth: none
}

headers {
  X-CSRFToken: {{csrf_token}}
}

assert {
  res.status: eq 200
}

docs {
  Staff/admin only. Marks a booked appointment as made (feeds reporting).
  Sibling endpoints: /no-show/, /cancel/, /reschedule/, /nail-art/.
}
