meta {
  name: Cancel appointment
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/appointments/{{appointment_id}}/cancel/
  body: none
  auth: none
}

headers {
  X-CSRFToken: {{csrf_token}}
}

assert {
  res.status: eq 200
}

docs {
  Client self-cancel — allowed only up to 24h before start_at (else 400, contact
  staff). Frees the time and alerts the waitlist.
}
