meta {
  name: Custom booking request
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/availability/custom-requests/
  body: json
  auth: none
}

headers {
  X-CSRFToken: {{csrf_token}}
}

body:json {
  {
    "service_id": "{{service_id}}",
    "preferred_date": "2026-12-20",
    "preferred_time": "14:00",
    "note": "beyond the booking horizon"
  }
}

assert {
  res.status: eq 201
}

docs {
  Client session + CSRF required. Not auto-confirmed — staff handle it in the BO.
}
