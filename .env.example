# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Rate limiting / throttling (DRF) ────────────────────────────────────────
# Per-IP (anon) and per-account (user) API limits; the OTP endpoints use the
# tighter `otp` scope. Format: "<count>/<period>" (period: s, min, hour, day).
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=240/min
THROTTLE_OTP_RATE=10/min

# ─── Dev seed (manage.py seed_dev) ───────────────────────────────────────────
# Admin superuser created for Django /admin/ by `make seed-dev` (DEBUG only).
SEED_ADMIN_MSISDN=+351900000000
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@beautystudio.pt

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=beautystudio
POSTGRES_USER=beautystudio
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Notifications (ADR 0007: WhatsApp → SMS → email) ────────────────────────
# Leave a provider's vars EMPTY in local dev — its client logs the message
# instead of sending (so SMS OTP and notifications stay testable offline).

# WhatsApp Cloud API (Meta) — primary channel. Business-initiated messages need
# pre-approved templates in Meta Business Manager.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Telnyx — SMS fallback + login OTP.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=+351900000000

# ─── Email (Resend, transactional) ───────────────────────────────────────────
# RESEND_API_KEY empty → Django email backend (console in dev).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@beautystudio.pt

# ─── Google Calendar (roadmap) ───────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/v1
NEXT_PUBLIC_BO_API_URL=http://localhost/bo/v1
