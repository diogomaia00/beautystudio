meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{base_url}}/v1/auth/logout/
  body: none
  auth: none
}

headers {
  X-CSRFToken: {{csrf_token}}
}

assert {
  res.status: eq 204
}

docs {
  Ends the session. Session-authenticated POST requires the CSRF token (from the
  csrftoken cookie set by the csrf request) in the X-CSRFToken header.
}
