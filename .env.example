# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=beautystudio
POSTGRES_USER=beautystudio
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Twilio (SMS / OTP) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+351900000000

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@beautystudio.pt

# ─── Google Calendar (roadmap) ───────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/v1
NEXT_PUBLIC_BO_API_URL=http://localhost/bo/v1
